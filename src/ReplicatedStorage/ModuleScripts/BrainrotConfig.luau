local RarityOrder = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Brainrot God", "Secret", "OG"}
local Definitions = {}
local ModelDefinitions = {}
local seenIds = {}

local function finiteNonNegative(value)
	return typeof(value) == "number" and value == value and value >= 0 and value < math.huge
end

local function validateDefinition(rarity, definition, key)
	local id = definition.BrainrotId
	if typeof(id) ~= "string" or id == "" then
		warn(string.format("[BrainrotConfig] %s/%s is missing BrainrotId", rarity, key))
		return false
	end
	if seenIds[id] then
		warn(string.format("[BrainrotConfig] Duplicate BrainrotId '%s' in %s and %s", id, seenIds[id], rarity))
		return false
	end
	seenIds[id] = rarity .. "/" .. key

	local minDamage, maxDamage = tonumber(definition.MinDamage), tonumber(definition.MaxDamage)
	if not finiteNonNegative(minDamage) or not finiteNonNegative(maxDamage) or minDamage > maxDamage then
		warn("[BrainrotConfig] Invalid damage range for " .. id)
		return false
	end
	if not finiteNonNegative(tonumber(definition.HP)) or tonumber(definition.HP) <= 0 then
		warn("[BrainrotConfig] Invalid HP for " .. id)
		return false
	end
	if not finiteNonNegative(tonumber(definition.Price)) then
		warn("[BrainrotConfig] Invalid Price for " .. id)
		return false
	end
	if not finiteNonNegative(tonumber(definition.SpawnChance)) then
		warn("[BrainrotConfig] Invalid SpawnChance for " .. id)
		return false
	end
	if typeof(definition.DisplayName) ~= "string" or definition.DisplayName == "" then
		warn("[BrainrotConfig] Missing DisplayName for " .. id)
		return false
	end
	return true
end

for _, rarity in ipairs(RarityOrder) do
	for key, definition in pairs(Brainrots[rarity] or {}) do
		if validateDefinition(rarity, definition, key) then
			definition.Rarity = rarity
			definition.ID = definition.BrainrotId
			definition.Name = definition.DisplayName
			definition.PurchaseCost = definition.Price
			definition.RizzDamage = definition.MinDamage
			definition.RizzReward = 0
			definition.CoinReward = 0
			definition.Lifetime = 60

			definition.Income = definition.Income or {}
			definition.Income.CoinsPerInterval = tonumber(definition.Income.CoinsPerInterval) or (definition.Income.Coins and tonumber(definition.Income.Coins)) or 0
			definition.Income.RizzPerInterval = tonumber(definition.Income.RizzPerInterval) or (definition.Income.Rizz and tonumber(definition.Income.Rizz)) or 0
			definition.IncomeInterval = tonumber(definition.IncomeInterval) or 3

			Definitions[definition.BrainrotId] = definition
			if definition.ModelName then
				ModelDefinitions[definition.ModelName] = definition
			end
		end
	end
end

local MutationConfig = {
	Normal = {DamageMultiplier = 1, HPMultiplier = 1},
	Gold = {DamageMultiplier = 1.25, HPMultiplier = 1.25},
	Diamond = {DamageMultiplier = 1.5, HPMultiplier = 1.5},
	Rainbow = {DamageMultiplier = 2, HPMultiplier = 2},
	Galaxy = {DamageMultiplier = 2.5, HPMultiplier = 2.5},
	Lava = {DamageMultiplier = 3, HPMultiplier = 3},
	Hacker = {DamageMultiplier = 4, HPMultiplier = 4},
}

local function getMutation(mutationName)
	if typeof(mutationName) ~= "string" or mutationName == "" then mutationName = "Normal" end
	return MutationConfig[mutationName] and mutationName or "Normal"
end

local function getMutationDefinition(mutationName)
	return MutationConfig[getMutation(mutationName)]
end

local function applyMutation(definition, mutationName)
	if not definition then return nil end
	local resolvedMutation = getMutation(mutationName)
	local mutation = MutationConfig[resolvedMutation]
	local result = table.clone(definition)
	result.Mutation = resolvedMutation
	result.DamageMultiplier = mutation.DamageMultiplier
	result.HPMultiplier = mutation.HPMultiplier
	result.MinDamage = math.max(0, (tonumber(definition.MinDamage) or 0) * mutation.DamageMultiplier)
	result.MaxDamage = math.max(result.MinDamage, (tonumber(definition.MaxDamage) or result.MinDamage) * mutation.DamageMultiplier)
	result.HP = math.max(1, (tonumber(definition.HP) or 1) * mutation.HPMultiplier)
	return result
end

local RarityInfo = {
	Common = {displayName = "Common", color = Color3.fromRGB(169, 169, 169), textColor = Color3.fromRGB(169, 169, 169)},
	Uncommon = {displayName = "Uncommon", color = Color3.fromRGB(85, 255, 127), textColor = Color3.fromRGB(85, 255, 127)},
	Rare = {displayName = "Rare", color = Color3.fromRGB(0, 179, 255), textColor = Color3.fromRGB(0, 150, 220)},
	Epic = {displayName = "Epic", color = Color3.fromRGB(128, 0, 255), textColor = Color3.fromRGB(100, 0, 200)},
	Legendary = {displayName = "Legendary", color = Color3.fromRGB(255, 215, 0), textColor = Color3.fromRGB(220, 190, 0)},
	Mythic = {displayName = "Mythic", color = Color3.fromRGB(139, 0, 139), textColor = Color3.fromRGB(139, 0, 139)},
	["Brainrot God"] = {displayName = "Brainrot God", color = Color3.fromRGB(255, 0, 255), textColor = Color3.fromRGB(255, 0, 255)},
	Secret = {displayName = "Secret", color = Color3.fromRGB(0, 0, 0), textColor = Color3.fromRGB(255, 255, 255)},
	OG = {displayName = "OG", color = Color3.fromRGB(255, 255, 255), textColor = Color3.fromRGB(255, 255, 255)},
}

for _, definition in pairs(Definitions) do
	definition.IncomePerSecond = tonumber(definition.IncomePerSecond) or math.max(1, math.floor((tonumber(definition.Price) or 0) / 100))
	definition.PerSec = definition.IncomePerSecond
	definition.price = definition.Price
	definition.perSec = definition.IncomePerSecond
	definition.displayName = definition.DisplayName
	definition.rarity = definition.Rarity
	definition.spawnWeight = definition.SpawnChance
	definition.RarityInfo = RarityInfo[definition.Rarity]
end

local function getDefinitionByName(name)
	return Definitions[name] or ModelDefinitions[name]
end

local function getDefinitionsByRarity(rarity)
	local results = {}
	for id, definition in pairs(Definitions) do
		if definition.Rarity == rarity and definition.Obtainable then
			table.insert(results, definition.ModelName or id)
		end
	end
	return results
end

local function formatCurrency(amount)
	amount = tonumber(amount) or 0
	if amount < 1000 then return "$" .. tostring(math.floor(amount)) end
	if amount >= 1e9 then return string.format("$%.2fB", amount / 1e9) end
	if amount >= 1e6 then return string.format("$%.2fM", amount / 1e6) end
	if amount >= 1e3 then return string.format("$%.2fK", amount / 1e3) end
	return "$" .. tostring(math.floor(amount))
end

local function formatPerSec(amount)
	return "+" .. formatCurrency(amount):gsub("%$", "") .. "/s"
end

